#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
case "${1:-start}" in
 start)
  if ! systemctl --user is-active --quiet purple-replay-downloads.service; then
   systemctl --user reset-failed purple-replay-downloads.service 2>/dev/null || true
   systemd-run --user --unit=purple-replay-downloads --description='Purple Replay — paquet Docker' /usr/bin/python -m http.server 8991 --bind 127.0.0.1 --directory "$project_dir/releases"
  fi ;;
 stop) systemctl --user stop purple-replay-downloads.service ;;
 restart) "$0" stop; "$0" start ;;
 *) exit 2 ;;
esac
